#version 450
// View-space ambient occlusion on the native depth grid. Colour is linear.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth_tex;
layout(binding = 1, rgba16f) uniform image2D scene;
layout(push_constant) uniform Params {
    vec4 projection; // P00, P11, P02, P12
    vec4 depth;      // P22, P23, P32, P33
    vec4 size;       // output width, height and reciprocals
    vec4 options;    // mode, strength, view-space radius, quality
} pc;

bool finite1(float v) { return !isnan(v) && !isinf(v); }
bool finite3(vec3 v) { return !any(isnan(v)) && !any(isinf(v)); }

bool position_at(ivec2 pixel, out vec3 p) {
    ivec2 ds = textureSize(depth_tex, 0);
    if (any(lessThan(pixel, ivec2(0))) || any(greaterThanEqual(pixel, ds))) return false;
    float d = texelFetch(depth_tex, pixel, 0).r;
    if (!finite1(d) || d <= 0.0 || d >= 1.0) return false;
    float ndcz = 2.0 * d - 1.0;
    float den = pc.depth.z * ndcz - pc.depth.x;
    if (abs(den) < 1e-12) return false;
    float z = (pc.depth.y - pc.depth.w * ndcz) / den;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(ds);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    p = vec3((ndc.x * -z - pc.projection.z * z) / pc.projection.x,
             (ndc.y * -z - pc.projection.w * z) / pc.projection.y, z);
    return z < 0.0 && finite3(p);
}

vec2 to_uv(vec3 p) {
    vec2 ndc = (pc.projection.xy * p.xy + pc.projection.zw * p.z) / -p.z;
    return vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
}

bool normal_at(ivec2 px, vec3 p, out vec3 n) {
    vec3 l, r, u, d;
    bool hl = position_at(px + ivec2(-1, 0), l), hr = position_at(px + ivec2(1, 0), r);
    bool hu = position_at(px + ivec2(0, -1), u), hd = position_at(px + ivec2(0, 1), d);
    if ((!hl && !hr) || (!hu && !hd)) return false;
    vec3 dx = !hl ? r-p : (!hr ? p-l : (abs(l.z-p.z) < abs(r.z-p.z) ? p-l : r-p));
    vec3 dy = !hu ? d-p : (!hd ? p-u : (abs(u.z-p.z) < abs(d.z-p.z) ? p-u : d-p));
    n = cross(dy, dx);
    float len = length(n);
    if (!finite1(len) || len < 1e-12) return false;
    n /= len;
    if (dot(n, -p) < 0.0) n = -n;
    return true;
}

float ao_ssao(ivec2 dp, vec3 p, vec3 n, float radius, int quality) {
    int count = quality == 0 ? 12 : (quality == 1 ? 24 : 32);
    vec3 axis = abs(n.z) < 0.9 ? vec3(0,0,1) : vec3(0,1,0);
    vec3 t = normalize(cross(axis, n)), b = cross(n, t);
    ivec2 ds = textureSize(depth_tex, 0);
    float sum = 0.0;
    for (int i = 0; i < count; ++i) {
        float f = (float(i) + 0.5) / float(count);
        float angle = float(i) * 2.39996323;
        float h = sqrt(f), lateral = sqrt(1.0-f);
        vec3 dir = t * (cos(angle) * lateral) + b * (sin(angle) * lateral) + n * h;
        vec3 target = p + dir * (radius * (0.2 + 0.8 * f));
        if (target.z >= -1e-5) continue;
        vec2 delta = (to_uv(target) - to_uv(p)) * vec2(ds);
        float dl = length(delta);
        if (!finite1(dl)) continue;
        if (dl > 64.0) delta *= 64.0 / dl;
        ivec2 sp = dp + ivec2(round(delta));
        vec3 q;
        if (!position_at(sp, q)) continue;
        vec3 v = q - p;
        float dist = length(v);
        if (dist < 1e-5 || dist >= radius || q.z <= target.z) continue;
        float elevation = dot(n, v) / dist;
        sum += smoothstep(0.02, 0.12, elevation) * (1.0 - dist*dist/(radius*radius));
    }
    return clamp(sum / float(count) * 2.0, 0.0, 1.0);
}

float ao_hbao(ivec2 dp, vec3 p, vec3 n, float radius, int quality) {
    int dirs = quality == 0 ? 4 : (quality == 1 ? 6 : 8);
    int steps = quality == 0 ? 3 : 4;
    ivec2 ds = textureSize(depth_tex, 0);
    vec3 view = normalize(-p);
    float nv = dot(n, view);
    if (nv <= 1e-4) return 0.0;
    float projected = min(64.0, radius * max(abs(pc.projection.x)*float(ds.x), abs(pc.projection.y)*float(ds.y)) / (2.0 * -p.z));
    float sum = 0.0;
    for (int i = 0; i < dirs; ++i) {
        float angle = 6.28318530718 * float(i) / float(dirs);
        vec2 direction = vec2(cos(angle), sin(angle));
        vec2 uv = to_uv(p) + direction / vec2(ds);
        vec2 ndc = vec2(uv.x*2.0-1.0, 1.0-uv.y*2.0);
        vec3 same_depth = vec3((ndc.x * -p.z - pc.projection.z*p.z)/pc.projection.x,
                               (ndc.y * -p.z - pc.projection.w*p.z)/pc.projection.y, p.z);
        vec3 screen = same_depth - p;
        screen -= view * dot(screen, view);
        if (length(screen) < 1e-8) continue;
        screen = normalize(screen);
        vec3 tangent = screen - view * (dot(n, screen) / nv);
        float horizon = dot(normalize(tangent), view);
        for (int j = 1; j <= steps; ++j) {
            ivec2 sp = dp + ivec2(round(direction * projected * float(j) / float(steps)));
            vec3 q;
            if (!position_at(sp, q)) continue;
            vec3 v = q-p;
            float dist = length(v);
            if (dist < 1e-5 || dist >= radius) continue;
            float elevation = dot(v / dist, view);
            float increase = max(0.0, elevation - horizon - 0.01);
            sum += increase * (1.0 - dist*dist/(radius*radius));
            horizon = max(horizon, elevation);
        }
    }
    return clamp(sum / float(dirs), 0.0, 1.0);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, imageSize(scene))) || any(greaterThanEqual(px, ivec2(pc.size.xy)))) return;
    if (!finite1(pc.options.x) || !finite1(pc.options.y) || !finite1(pc.options.z) || !finite1(pc.options.w) || pc.options.y <= 0.0 || pc.options.z <= 0.0) return;
    if (pc.options.x < 0.5 || pc.options.x >= 2.5) return;
    vec2 uv = (vec2(px) + 0.5) * pc.size.zw;
    ivec2 dp = ivec2(uv * vec2(textureSize(depth_tex, 0)));
    vec3 p, n;
    if (!position_at(dp, p) || !normal_at(dp, p, n)) return;
    int quality = int(clamp(pc.options.w, 0.0, 2.0));
    float occ = pc.options.x < 1.5 ? ao_ssao(dp, p, n, pc.options.z, quality) : ao_hbao(dp, p, n, pc.options.z, quality);
    if (!finite1(occ) || occ <= 0.0) return;
    vec4 c = imageLoad(scene, px);
    imageStore(scene, px, vec4(c.rgb * (1.0 - clamp(pc.options.y, 0.0, 1.0) * occ), c.a));
}
